# =====================================================
# 절대 GitHub에 올리면 안 되는 것 — API 키
# =====================================================
.env
.env.local
.env.*.local

# =====================================================
# 자동 생성 파일 — 굳이 올릴 필요 없음
# =====================================================
# 배포용 인덱스는 zip으로 압축해 푸시한다.
# (주의: gitignore는 줄 끝 주석을 패턴의 일부로 읽는다 — 같은 줄에 # 주석 금지)
data/chroma_db/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# =====================================================
# 가상환경
# =====================================================
venv/
env/
ENV/
.venv/

# =====================================================
# IDE 설정
# =====================================================
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# =====================================================
# Streamlit
# =====================================================
.streamlit/secrets.toml

# =====================================================
# 캐시
# =====================================================
.pytest_cache/
.cache/
*.log

# =====================================================
# 정책 자료 PDF — GitHub에 안 올리는 게 안전
# (저작권 문제는 없으나 용량 절약)
# =====================================================
# data/policy_docs/*.pdf
# data/policy_docs/*.xlsx
# → 주석 해제 시 PDF/엑셀이 git에서 제외됨
#   민회님 본인 PC에서만 작업할 거면 위 주석 풀기 권장
data/chroma_db.zip.bak

# Claude Code — 개인 권한 설정 (커밋 금지). launch.json은 팀 공유라 추적.
.claude/settings.local.json

# =====================================================
# 발표 자료 — 원본 영상·PPT는 용량이 커서 올리지 않는다
#   presentation_design 전체가 652MB인데 그 대부분이 홍보영상 mp4다.
#   기획서는 '만드는 소스'(HTML·CSS·JS·글꼴·캡처)와 결과 PDF만 올린다.
# =====================================================
presentation_design/*.mp4
presentation_design/*.pptx
presentation_design/*.pdf
presentation_design/pptx_png/
presentation_design/plan_slides/
presentation_design/slides/
presentation_design/plan_deck/node_modules/
presentation_design/plan_deck/out/qa/
